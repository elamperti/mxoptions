# Started from the i3 config ("exec --no-startup-id systemctl --user start i3-session.target").
# i3 does not start graphical-session.target, which mxoptions.service is tied to; this target
# pulls it in, the same way sway-session.target does for sway.
[Unit]
Description=i3 session
Documentation=man:systemd.special(7)
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
